<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UploadActivity">

    <!-- Botón para agregar nueva matrícula -->
    <Button
        android:id="@+id/buttonBackToHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nueva Matrícula"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:onClick="returnToMainActivity" />

    <!-- ListView para mostrar las matrículas obtenidas de la API -->
    <ListView
        android:id="@+id/listViewMatriculas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonBackToHome"
        android:layout_marginTop="16dp"
        android:layout_above="@id/scrollViewPhotos"
        android:layout_marginBottom="16dp" />

    <!-- ScrollView para contener fotos capturadas -->
    <ScrollView
        android:id="@+id/scrollViewPhotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <!-- Contenedor lineal para las fotos -->
        <LinearLayout
            android:id="@+id/photoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</RelativeLayout>
